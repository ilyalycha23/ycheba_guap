#Область ПрограммныйИнтерфейс

Функция ТребуетсяИсправлениеАдресации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Поле
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Должности КАК Должности
	|		ПО Задачи.Должность = Должности.Ссылка
	|ГДЕ
	|	Задачи.Должность <> ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)
	|	И Должности.Ссылка ЕСТЬ NULL";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ИсправитьАдресациюЗадач() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Лог = Новый Массив;
	
	ОбеспечитьДолжности(Лог);
	УдалитьДубликатыСотрудников(Лог);
	КартаДолжностей = ПолучитьКартуДолжностей();
	Лог.Добавить("Должностей в карте: " + КартаДолжностей.Количество());
	
	ПересоздатьАдресациюЗадач(КартаДолжностей, Лог);
	ИсправленоЗадач = ИсправитьЗадачи(КартаДолжностей, Лог);
	Лог.Добавить("Обновлено задач: " + ИсправленоЗадач);
	
	ЗаписатьЛог(Лог);
	
КонецПроцедуры

Процедура ИсправитьАдресациюЗадачПриСтарте() Экспорт
	ИсправитьАдресациюЗадач();
КонецПроцедуры

Функция АктуальнаяДолжность(Имя) Экспорт
	
	Представление = Имя;
	Если Имя = "СистемныйАдминистратор" Тогда
		Представление = "Системный администратор";
	КонецЕсли;
	
	Возврат НайтиДолжность(Имя, Представление);
	
КонецФункции

Функция СотрудникПоДолжности(Должность) Экспорт
	
	Возврат НайтиСотрудникаПоДолжности(Должность);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбеспечитьДолжности(Лог)
	
	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("Имя, Код, Представление", "Администратор", "000000001", "Администратор зала"));
	Описания.Добавить(Новый Структура("Имя, Код, Представление", "Оператор", "000000002", "Кассир"));
	Описания.Добавить(Новый Структура("Имя, Код, Представление", "Управляющий", "000000003", "Управляющий"));
	Описания.Добавить(Новый Структура("Имя, Код, Представление", "СистемныйАдминистратор", "000000004", "Системный администратор"));
	
	Для Каждого Описание Из Описания Цикл
		
		Ссылка = НайтиДолжность(Описание.Имя, Описание.Представление);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Лог.Добавить("Должность найдена: " + Описание.Представление);
			Продолжить;
		КонецЕсли;
		
		Объект = Справочники.Должности.СоздатьЭлемент();
		Объект.Код = Описание.Код;
		Объект.Наименование = Описание.Представление;
		Объект.Записать();
		Лог.Добавить("Создана должность: " + Описание.Представление);
		
	КонецЦикла;
	
	УдалитьДубликатыДолжностей(Лог);
	
КонецПроцедуры

Процедура УдалитьДубликатыДолжностей(Лог)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Должности.Ссылка КАК Ссылка,
	|	Должности.Наименование КАК Наименование,
	|	Должности.Предопределенный КАК Предопределенный
	|ИЗ
	|	Справочник.Должности КАК Должности
	|ГДЕ
	|	НЕ Должности.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Предопределенный УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТекущееНаименование = "";
	Удалено = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Наименование <> ТекущееНаименование Тогда
			ТекущееНаименование = Выборка.Наименование;
			Продолжить;
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(Истина);
		Удалено = Удалено + 1;
		
	КонецЦикла;
	
	Лог.Добавить("Удалено дубликатов должностей: " + Удалено);
	
КонецПроцедуры

Процедура УдалитьДубликатыСотрудников(Лог)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Ссылка,
	|	Сотрудники.Наименование КАК Наименование,
	|	Сотрудники.Владелец.Наименование КАК ДолжностьНаименование
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	ДолжностьНаименование,
	|	Сотрудники.Код";
	
	Канонические = Новый Соответствие;
	Удалено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Ключ = СокрЛП(Выборка.Наименование) + "|" + СокрЛП(Выборка.ДолжностьНаименование);
		КаноническаяСсылка = Канонические.Получить(Ключ);
		
		Если КаноническаяСсылка = Неопределено Тогда
			Канонические.Вставить(Ключ, Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		ЗаменитьСсылкиНаСотрудника(Выборка.Ссылка, КаноническаяСсылка);
		УдалитьЭлементСправочника(Выборка.Ссылка);
		Удалено = Удалено + 1;
		
	КонецЦикла;
	
	Лог.Добавить("Удалено дубликатов сотрудников: " + Удалено);
	
КонецПроцедуры

Процедура ЗаменитьСсылкиНаСотрудника(СтараяСсылка, НоваяСсылка)
	
	Если Не ЗначениеЗаполнено(СтараяСсылка) Или Не ЗначениеЗаполнено(НоваяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Задачи.Ссылка КАК Ссылка ИЗ Задача.ЗадачаИсполнителя КАК Задачи ГДЕ Задачи.Сотрудник = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник", СтараяСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Сотрудник = НоваяСсылка;
		Объект.Записать();
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Адресация.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.АдресацияЗадач КАК Адресация
	|ГДЕ
	|	Адресация.Сотрудник = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник", СтараяСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.АдресацияЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Должность = Выборка.Должность;
		МенеджерЗаписи.Сотрудник = СтараяСсылка;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
		МенеджерЗаписи = РегистрыСведений.АдресацияЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Должность = Выборка.Должность;
		МенеджерЗаписи.Сотрудник = НоваяСсылка;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьЭлементСправочника(Ссылка)
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект.Удалить();
	Исключение
		Объект.УстановитьПометкуУдаления(Истина);
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьКартуДолжностей()
	
	Карта = Новый Соответствие;
	Имена = Новый Массив;
	Имена.Добавить("Администратор");
	Имена.Добавить("Оператор");
	Имена.Добавить("Управляющий");
	Имена.Добавить("СистемныйАдминистратор");
	
	Для Каждого Имя Из Имена Цикл
		Представление = Имя;
		Если Имя = "СистемныйАдминистратор" Тогда
			Представление = "Системный администратор";
		КонецЕсли;
		Ссылка = НайтиДолжность(Имя, Представление);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Карта.Вставить(Имя, Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Карта;
	
КонецФункции

Функция НайтиДолжность(Имя, Представление = "")
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Представление = Имя;
	КонецЕсли;
	
	СсылкаПредопределенная = ПредопределеннаяДолжность(Имя);
	Если ЗначениеЗаполнено(СсылкаПредопределенная) Тогда
		Возврат СсылкаПредопределенная;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Должности.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Должности КАК Должности
	|ГДЕ
	|	НЕ Должности.ПометкаУдаления
	|	И (Должности.ИмяПредопределенныхДанных = &Имя
	|		ИЛИ Должности.Наименование = &Представление
	|		ИЛИ Должности.Наименование = &Имя)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Должности.Предопределенный УБЫВ";
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Представление", Представление);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Должности.ПустаяСсылка();
	
КонецФункции

Функция ПредопределеннаяДолжность(Имя)
	
	Попытка
		Ссылка = Справочники.Должности[Имя];
	Исключение
		Возврат Справочники.Должности.ПустаяСсылка();
	КонецПопытки;
	
	Если СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Должности.ПустаяСсылка();
	
КонецФункции

Функция СсылкаСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяТаблицы = Ссылка.Метаданные().ПолноеИмя();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ " + ИмяТаблицы + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ПересоздатьАдресациюЗадач(КартаДолжностей, Лог)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Адресация.Должность, Адресация.Сотрудник ИЗ РегистрСведений.АдресацияЗадач КАК Адресация";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.АдресацияЗадач.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Должность = Выборка.Должность;
		МенеджерЗаписи.Сотрудник = Выборка.Сотрудник;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЦикла;
	
	ДолжностьАдмин = КартаДолжностей.Получить("Администратор");
	ДолжностьОператор = КартаДолжностей.Получить("Оператор");
	ДолжностьУправляющий = КартаДолжностей.Получить("Управляющий");
	
	ОбеспечитьСотрудника("Смирнова Елена Викторовна", ДолжностьАдмин, Лог);
	ОбеспечитьСотрудника("Петров Игорь Николаевич", ДолжностьОператор, Лог);
	ОбеспечитьСотрудника("Волкова Мария Александровна", ДолжностьУправляющий, Лог);
	
	Сотрудник1 = НайтиСотрудника("Смирнова Елена Викторовна", ДолжностьАдмин);
	Сотрудник2 = НайтиСотрудника("Петров Игорь Николаевич", ДолжностьОператор);
	Сотрудник3 = НайтиСотрудника("Волкова Мария Александровна", ДолжностьУправляющий);
	
	ДобавитьАдресацию(ДолжностьАдмин, Сотрудник1);
	ДобавитьАдресацию(ДолжностьОператор, Сотрудник2);
	ДобавитьАдресацию(ДолжностьУправляющий, Сотрудник3);
	
	Лог.Добавить("Адресация задач пересоздана");
	
КонецПроцедуры

Процедура ОбеспечитьСотрудника(ФИО, Должность, Лог)
	
	Если Не ЗначениеЗаполнено(Должность) Тогда
		Возврат;
	КонецЕсли;
	
	Сотрудник = НайтиСотрудника(ФИО, Должность);
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Объект = Справочники.Сотрудники.СоздатьЭлемент();
		Объект.Владелец = Должность;
		Объект.Наименование = ФИО;
		Объект.Записать();
		Лог.Добавить("Создан сотрудник: " + ФИО);
		Возврат;
	КонецЕсли;
	
	Объект = Сотрудник.ПолучитьОбъект();
	Если Объект.Владелец <> Должность Тогда
		Объект.Владелец = Должность;
		Объект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьАдресацию(Должность, Сотрудник)
	
	Если Не ЗначениеЗаполнено(Должность) Или Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.АдресацияЗадач.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Должность = Должность;
	МенеджерЗаписи.Сотрудник = Сотрудник;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

Функция ИсправитьЗадачи(КартаДолжностей, Лог)
	
	Исправлено = 0;
	Всего = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Всего = Всего + 1;
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Должность = ДолжностьДляЗадачи(Объект, КартаДолжностей);
		Если Не ЗначениеЗаполнено(Должность) Тогда
			Продолжить;
		КонецЕсли;
		
		Сотрудник = НайтиСотрудникаПоДолжности(Должность);
		Если Объект.Должность <> Должность Или Объект.Сотрудник <> Сотрудник Тогда
			Объект.Должность = Должность;
			Объект.Сотрудник = Сотрудник;
			Объект.Записать();
			Исправлено = Исправлено + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Лог.Добавить("Всего задач: " + Всего);
	Возврат Исправлено;
	
КонецФункции

Функция ДолжностьДляЗадачи(Задача, КартаДолжностей)
	
	Если ЗначениеЗаполнено(Задача.Основание) И ТипЗнч(Задача.Основание) = Тип("ДокументСсылка.ЗаказВБар") Тогда
		Возврат КартаДолжностей.Получить("Администратор");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Задача.ТочкаМаршрута) Тогда
		
		Если Задача.ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ВстречаПосетителя Тогда
			Возврат КартаДолжностей.Получить("Оператор");
		ИначеЕсли Задача.ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ПросмотрФильма Тогда
			Возврат КартаДолжностей.Получить("Администратор");
		ИначеЕсли Задача.ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ОплатаБилетов Тогда
			Возврат КартаДолжностей.Получить("Управляющий");
		КонецЕсли;
		
	КонецЕсли;
	
	Если СсылкаСуществует(Задача.Должность) Тогда
		Возврат Задача.Должность;
	КонецЕсли;
	
	Возврат КартаДолжностей.Получить("Оператор");
	
КонецФункции

Функция НайтиСотрудника(ФИО, Должность)
	
	Если Не ЗначениеЗаполнено(Должность) Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка КАК Ссылка
