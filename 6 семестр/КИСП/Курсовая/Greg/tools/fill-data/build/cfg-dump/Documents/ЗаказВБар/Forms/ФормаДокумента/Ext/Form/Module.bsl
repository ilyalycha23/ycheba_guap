&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	Данные = ПолучитьДанныеНоменклатуры(Объект.Номенклатура);
	Объект.Цена = Данные.Цена;
	РассчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	РассчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)
	РассчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСумму()
	Объект.Сумма = Объект.Цена * Объект.Количество;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьУслугу(Команда)
	Если Объект.Завершен Тогда
		Сообщить("Заказ уже завершён!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите и проведите документ!");
		Возврат;
	КонецЕсли;
	
	ЗавершитьУслугуНаСервере();
	Сообщить("Заказ в бар успешно завершён. Созданы документы продажи и оплаты.");
КонецПроцедуры

&НаСервере
Процедура ЗавершитьУслугуНаСервере()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.ЗавершитьЗаказ();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры
Функция ПолучитьДанныеНоменклатуры(Номенклатура)
	Данные = Новый Структура("Цена", 0);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Данные.Цена = Номенклатура.Цена;
	КонецЕсли;
	Возврат Данные;
КонецФункции
