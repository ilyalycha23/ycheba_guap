Процедура ОбработкаПроведения(Отказ, Режим)
	// Группируем товары для правильного расчета средней себестоимости
	ТаблицаТоваров = Товары.Выгрузить();
	ТаблицаТоваров.Свернуть("Номенклатура", "Количество, Сумма");
	
	Для Каждого СтрокаТЧ Из ТаблицаТоваров Цикл
		// Движения по складу
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТЧ.Номенклатура;
		Движение.Количество = СтрокаТЧ.Количество;
		
		// Бухгалтерия
		ДвижениеБух = Движения.Проводки.Добавить();
		ДвижениеБух.Период = Дата;
		ДвижениеБух.СчетДт = ПланыСчетов.Управленческий.Касса; // Временно касса (расход)
		ДвижениеБух.СчетКт = ПланыСчетов.Управленческий.Касса;
		ДвижениеБух.Сумма = -СтрокаТЧ.Сумма; // Расход денег
		
		// Расчет средней себестоимости
		НомОбъект = СтрокаТЧ.Номенклатура.ПолучитьОбъект();
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Остаток ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Период, Номенклатура = &Ном)";
		Запрос.УстановитьПараметр("Период", Дата);
		Запрос.УстановитьПараметр("Ном", СтрокаТЧ.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		ТекущийОстаток = 0;
		Если Выборка.Следующий() Тогда
			ТекущийОстаток = Выборка.Остаток;
		КонецЕсли;
		
		ТекущаяСебестоимость = НомОбъект.Себестоимость;
		ТекущаяСтоимость = ТекущийОстаток * ТекущаяСебестоимость;
		
		НовоеКоличество = ТекущийОстаток + СтрокаТЧ.Количество;
		НоваяСтоимость = ТекущаяСтоимость + СтрокаТЧ.Сумма;
		
		Если НовоеКоличество > 0 Тогда
			НомОбъект.Себестоимость = НоваяСтоимость / НовоеКоличество;
		Иначе
			НомОбъект.Себестоимость = 0;
		КонецЕсли;
		
		НомОбъект.Записать();
	КонецЦикла;
КонецПроцедуры
