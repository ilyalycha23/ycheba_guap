&НаКлиенте
Процедура ЗавершитьСеанс(Команда)
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ПоказатьОповещениеПользователя("Внимание", , "Сначала запишите документ!");
		Возврат;
	КонецЕсли;
	
	ЗавершитьСеансНаСервере();
	ПоказатьОповещениеПользователя("Успех", , "Киносеанс завершён, документ оплаты создан.");
КонецПроцедуры

&НаСервере
Процедура ЗавершитьСеансНаСервере()
	Объект.ОкончаниеСеанса = ТекущаяДата();
	Объект.Завершен = Истина;
	
	ЗапросЗадачи = Новый Запрос;
	ЗапросЗадачи.Текст = 
		"ВЫБРАТЬ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.ТочкаМаршрута = ЗНАЧЕНИЕ(БизнесПроцесс.ОбслуживаниеПосетителя.ТочкаМаршрута.ПросмотрФильма)
		|	И ЗадачаИсполнителя.БизнесПроцесс.Клиент = &Клиент
		|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ";
	ЗапросЗадачи.УстановитьПараметр("Клиент", Объект.Клиент);
	РезультатЗадачи = ЗапросЗадачи.Выполнить();
	Если Не РезультатЗадачи.Пустой() Тогда
		ВыборкаЗадачи = РезультатЗадачи.Выбрать();
		Пока ВыборкаЗадачи.Следующий() Цикл
			ЗадачаОбъект = ВыборкаЗадачи.Ссылка.ПолучитьОбъект();
			ЗадачаОбъект.ВыполнитьЗадачу();
		КонецЦикла;
	КонецЕсли;
	
	ДокОплата = Документы.Оплата.СоздатьДокумент();
	ДокОплата.Дата = ТекущаяДата();
	ДокОплата.Клиент = Объект.Клиент;
	ДокОплата.Сумма = Объект.Сумма;
	ДокОплата.Записать(РежимЗаписиДокумента.Проведение);
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНаОснованииЗаказВБар(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите документ!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.ЗаказВБар.ФормаОбъекта", ПараметрыФормы);
КонецПроцедуры
