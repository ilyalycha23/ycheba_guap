КонецПроцедуры

Процедура ДобавитьАдресацию(Должность, Сотрудник)
	
	Набор = РегистрыСведений.АдресацияЗадач.СоздатьНаборЗаписей();
	Набор.Отбор.Должность.Установить(Должность);
	Набор.Отбор.Сотрудник.Установить(Сотрудник);
	Запись = Набор.Добавить();
	Запись.Должность = Должность;
	Запись.Сотрудник = Сотрудник;
	Набор.Записать();
	
КонецПроцедуры

Процедура ПровестиВводЗалов(ДатаДок)
	
	Док = Документы.ВводЗалаВЭксплуатацию.СоздатьДокумент();
	Док.Дата = ДатаДок;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, СебестоимостьЗала ИЗ Справочник.Кинозалы");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Док.Кинозалы.Добавить();
		Строка.Кинозал = Выборка.Ссылка;
		Строка.Стоимость = Выборка.СебестоимостьЗала;
	КонецЦикла;
	
	Док.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура ПровестиПоступлениеТоваров(ДатаДок)
	
	Док = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Док.Дата = ДатаДок;
	
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Себестоимость ИЗ Справочник.Номенклатура");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Док.Товары.Добавить();
		Строка.Номенклатура = Выборка.Ссылка;
		Строка.Количество = 100;
		Строка.Цена = Выборка.Себестоимость;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;
	
	Док.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция РассчитатьСуммуБилетов(ТипБилета, КоличествоБилетов)
	
	Если ТипБилета.КатегорияБилета = "Пакет" Или ТипБилета.КатегорияБилета = "Абонемент" Тогда
		Возврат ТипБилета.Цена;
	КонецЕсли;
	
	Возврат ТипБилета.Цена * КоличествоБилетов;
	
КонецФункции

Функция СоздатьЗаявку(ДатаДок, Клиент, Кинозал, ТипБилета, Фильм, КоличествоБилетов, НачалоСеанса)
	
	Док = Документы.ЗаявкаНаБроньБилетов.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Клиент = Клиент;
	Док.Кинозал = Кинозал;
	Док.ТипБилета = ТипБилета;
	Док.Фильм = Фильм;
	Док.КоличествоБилетов = КоличествоБилетов;
	Док.НачалоСеанса = НачалоСеанса;
	Док.ОкончаниеСеанса = НачалоСеанса + Фильм.Продолжительность * 60;
	Док.Сумма = РассчитатьСуммуБилетов(ТипБилета, КоличествоБилетов);
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док.Ссылка;
	
КонецФункции

Функция СоздатьПродажуИзЗаявки(ДатаДок, Заявка)
	
	Док = Документы.ПродажаБилетов.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Заполнить(Заявка);
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док;
	
КонецФункции

Функция СоздатьПродажуНапрямую(ДатаДок, Клиент, Кинозал, ТипБилета, Фильм, КоличествоБилетов, НачалоСеанса)
	
	Док = Документы.ПродажаБилетов.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Клиент = Клиент;
	Док.Кинозал = Кинозал;
	Док.ТипБилета = ТипБилета;
	Док.Фильм = Фильм;
	Док.КоличествоБилетов = КоличествоБилетов;
	Док.НачалоСеанса = НачалоСеанса;
	Док.ОкончаниеСеанса = НачалоСеанса + Фильм.Продолжительность * 60;
	Док.Сумма = РассчитатьСуммуБилетов(ТипБилета, КоличествоБилетов);
	Док.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Док;
	
КонецФункции

Процедура СоздатьОплату(ДатаДок, Клиент, Сумма)
	
	Док = Документы.Оплата.СоздатьДокумент();
	Док.Дата = ДатаДок;
