КонецПроцедуры

Процедура ЗавершитьЗадачуПросмотра(Клиент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.ТочкаМаршрута = ЗНАЧЕНИЕ(БизнесПроцесс.ОбслуживаниеПосетителя.ТочкаМаршрута.ПросмотрФильма)
		|	И ЗадачаИсполнителя.БизнесПроцесс.Клиент = &Клиент
		|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗадачаОбъект.ВыполнитьЗадачу();
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьЗаказВБар(ДатаДок, Клиент, Кинозал, Номенклатура, Количество)
	
	Док = Документы.ЗаказВБар.СоздатьДокумент();
	Док.Дата = ДатаДок;
	Док.Клиент = Клиент;
	Док.Кинозал = Кинозал;
	Док.Номенклатура = Номенклатура;
	Док.Количество = Количество;
	Док.Цена = Номенклатура.Цена;
	Док.Сумма = Док.Цена * Док.Количество;
	Док.Записать(РежимЗаписиДокумента.Проведение);
	
	ДокОбъект = Док.Ссылка.ПолучитьОбъект();
	ДокОбъект.ЗавершитьЗаказ();
	
КонецПроцедуры

#КонецОбласти
