	ДолжностьОператор = Справочники.Должности.Оператор;
	ДолжностьУправляющий = Справочники.Должности.Управляющий;
	
	Сотрудник1 = Справочники.Сотрудники.НайтиПоНаименованию("Смирнова Елена Викторовна", Истина);
	Сотрудник2 = Справочники.Сотрудники.НайтиПоНаименованию("Петров Игорь Николаевич", Истина);
