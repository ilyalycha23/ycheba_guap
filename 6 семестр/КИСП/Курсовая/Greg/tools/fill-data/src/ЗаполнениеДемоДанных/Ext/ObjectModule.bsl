Процедура ЗаполнитьДемоДанные() Экспорт
	
	Если ДемоДанныеУжеЗагружены() Тогда
		Сообщить("Демо-данные уже присутствуют в базе. Повторная загрузка пропущена.");
		Возврат;
	КонецЕсли;
	
	ДатаБаза = НачалоДня(ТекущаяДата());
	
	// --- Справочники ---
	СоздатьФильмы();
	СоздатьТипыБилетов();
	СоздатьКинозалы();
	Клиент1 = СоздатьКлиента("Иванов Пётр Сергеевич", "+7 (921) 111-22-33");
	Клиент2 = СоздатьКлиента("Сидорова Анна Михайловна", "+7 (921) 444-55-66");
	Клиент3 = СоздатьКлиента("Козлов Дмитрий Андреевич", "+7 (921) 777-88-99");
	СоздатьСотрудников();
	СоздатьНоменклатуруБара();
	СоздатьАдресациюЗадач();
	
	// --- Документы ---
	ПровестиВводЗалов(ДатаБаза - 7 * 86400);
	ПровестиПоступлениеТоваров(ДатаБаза - 3 * 86400);
	
	ФильмМатрица = Справочники.Фильмы.НайтиПоНаименованию("Матрица", Истина);
	ФильмБрат = Справочники.Фильмы.НайтиПоНаименованию("Брат", Истина);
	ФильмАватар = Справочники.Фильмы.НайтиПоНаименованию("Аватар", Истина);
	
	Зал1 = Справочники.Кинозалы.НайтиПоНаименованию("Зал 1", Истина);
	Зал2 = Справочники.Кинозалы.НайтиПоНаименованию("Зал 2", Истина);
	VIPЗал = Справочники.Кинозалы.НайтиПоНаименованию("VIP-зал", Истина);
	
	БилетСтандарт = Справочники.ТипыБилетов.НайтиПоНаименованию("Стандарт", Истина);
	БилетЛьготный = Справочники.ТипыБилетов.НайтиПоНаименованию("Льготный", Истина);
	БилетVIP = Справочники.ТипыБилетов.НайтиПоНаименованию("VIP", Истина);
	
	НачалоСеанса1 = ДатаБаза + 14 * 3600;
	НачалоСеанса2 = ДатаБаза + 17 * 3600;
	НачалоСеанса3 = ДатаБаза + 19 * 3600 + 30 * 60;
	
	// Цепочка 1: заявка -> продажа -> оплата (БП)
	Заявка1 = СоздатьЗаявку(ДатаБаза, Клиент1, Зал1, БилетСтандарт, ФильмМатрица, 2, НачалоСеанса1);
	Продажа1 = СоздатьПродажуИзЗаявки(ДатаБаза + 1800, Заявка1);
	СоздатьОплату(ДатаБаза + 3600, Клиент1, Продажа1.Сумма);
	ЗавершитьЗадачуПросмотра(Клиент1);
	
	// Цепочка 2: заявка VIP
	Заявка2 = СоздатьЗаявку(ДатаБаза, Клиент2, VIPЗал, БилетVIP, ФильмАватар, 3, НачалоСеанса2);
	СоздатьПродажуИзЗаявки(ДатаБаза + 5400, Заявка2);
	
	// Прямая продажа без заявки
	СоздатьПродажуНапрямую(ДатаБаза + 7200, Клиент3, Зал2, БилетЛьготный, ФильмБрат, 1, НачалоСеанса3);
	
	// Заказ в бар
	Попкорн = Справочники.Номенклатура.НайтиПоНаименованию("Попкорн солёный", Истина);
	СоздатьЗаказВБар(ДатаБаза + 9000, Клиент1, Зал1, Попкорн, 2);
	
	Сообщить("Демо-данные киноцентра успешно загружены.");
	
КонецПроцедуры

#КонецОбласти

