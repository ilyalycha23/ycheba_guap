Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаБроньБилетов") Тогда
		Клиент = ДанныеЗаполнения.Клиент;
		Кинозал = ДанныеЗаполнения.Кинозал;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если ЗначениеЗаполнено(ВедущаяЗадача) Тогда
		Заказ = ВедущаяЗадача.Основание;
		Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказВБар") Тогда
			Если Не ЗначениеЗаполнено(Клиент) Тогда
				Клиент = Заказ.Клиент;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Кинозал) Тогда
				Кинозал = Заказ.Кинозал;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВстречаПосетителяПриСозданииЗадач(ТочкаМаршрута, ФормируемыеЗадачи, Отказ)
	ЗаполнитьАдресациюЗадач(ФормируемыеЗадачи, ТочкаМаршрута);
КонецПроцедуры

Процедура ПросмотрФильмаПриСозданииЗадач(ТочкаМаршрута, ФормируемыеЗадачи, Отказ)
	ЗаполнитьАдресациюЗадач(ФормируемыеЗадачи, ТочкаМаршрута);
КонецПроцедуры

Процедура ОплатаБилетовПриСозданииЗадач(ТочкаМаршрута, ФормируемыеЗадачи, Отказ)
	ЗаполнитьАдресациюЗадач(ФормируемыеЗадачи, ТочкаМаршрута);
КонецПроцедуры

Процедура ЗаполнитьАдресациюЗадач(ФормируемыеЗадачи, ТочкаМаршрута)
	
	Для Каждого Задача Из ФормируемыеЗадачи Цикл
		
		Задача.ТочкаМаршрута = ТочкаМаршрута;
		Должность = ДолжностьПоТочкеМаршрута(ТочкаМаршрута);
		
		Если ЗначениеЗаполнено(Должность) Тогда
			Задача.Должность = Должность;
			Задача.Сотрудник = СервисДанных.СотрудникПоДолжности(Должность);
		ИначеЕсли Не СсылкаСуществует(Задача.Должность) Тогда
			Задача.Должность = СервисДанных.АктуальнаяДолжность("Оператор");
			Задача.Сотрудник = СервисДанных.СотрудникПоДолжности(Задача.Должность);
		ИначеЕсли Не ЗначениеЗаполнено(Задача.Сотрудник) Или Не СсылкаСуществует(Задача.Сотрудник) Тогда
			Задача.Сотрудник = СервисДанных.СотрудникПоДолжности(Задача.Должность);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ДолжностьПоТочкеМаршрута(ТочкаМаршрута)
	
	Если ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ВстречаПосетителя Тогда
		Возврат СервисДанных.АктуальнаяДолжность("Оператор");
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ПросмотрФильма Тогда
		Возврат СервисДанных.АктуальнаяДолжность("Администратор");
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.ОбслуживаниеПосетителя.ТочкиМаршрута.ОплатаБилетов Тогда
		Возврат СервисДанных.АктуальнаяДолжность("Управляющий");
	КонецЕсли;
	
	Возврат Справочники.Должности.ПустаяСсылка();
	
КонецФункции

Функция СсылкаСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции
