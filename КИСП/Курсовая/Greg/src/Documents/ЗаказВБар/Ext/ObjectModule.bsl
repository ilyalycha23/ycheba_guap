Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПродажаБилетов") Тогда
		Клиент = ДанныеЗаполнения.Клиент;
		Кинозал = ДанныеЗаполнения.Кинозал;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	// Создаем задачу исполнителя
	НоваяЗадача = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	НоваяЗадача.Наименование = "Заказ в бар: " + Строка(Номенклатура);
	НоваяЗадача.Дата = Дата;
	НоваяЗадача.Основание = Ссылка;
	
	// Назначаем исполнителя (без жесткой привязки к точке маршрута БП, чтобы не вызывать зацикливание)
	НоваяЗадача.Должность = СервисДанных.АктуальнаяДолжность("Администратор");
	НоваяЗадача.Сотрудник = СервисДанных.СотрудникПоДолжности(НоваяЗадача.Должность);
	
	НоваяЗадача.Записать();
КонецПроцедуры

Процедура ЗавершитьЗаказ() Экспорт
	Если Завершен Тогда Возврат; КонецЕсли;
	
	// Создаем продажу товаров
	ДокПродажа = Документы.ПродажаТоваров.СоздатьДокумент();
	ДокПродажа.Дата = Дата;
	ДокПродажа.Клиент = Клиент;
	
	НоваяСтрока = ДокПродажа.Товары.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Количество = Количество;
	НоваяСтрока.Цена = Цена;
	НоваяСтрока.Сумма = Сумма;
	
	ДокПродажа.Записать(РежимЗаписиДокумента.Проведение);
	
	ДокОплата = Документы.Оплата.СоздатьДокумент();
	ДокОплата.Дата = Дата;
	ДокОплата.Клиент = Клиент;
	ДокОплата.Сумма = Сумма;
	ДокОплата.Записать(РежимЗаписиДокумента.Проведение);
	
	Завершен = Истина;
	Записать(РежимЗаписиДокумента.Запись);
КонецПроцедуры