Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаБроньБилетов") Тогда
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		Клиент = ДанныеЗаполнения.Клиент;
		Кинозал = ДанныеЗаполнения.Кинозал;
		ТипБилета = ДанныеЗаполнения.ТипБилета;
		Фильм = ДанныеЗаполнения.Фильм;
		КоличествоБилетов = ДанныеЗаполнения.КоличествоБилетов;
		НачалоСеанса = ДанныеЗаполнения.НачалоСеанса;
		ОкончаниеСеанса = ДанныеЗаполнения.ОкончаниеСеанса;
		Сумма = ДанныеЗаполнения.Сумма;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если КоличествоБилетов <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите количество билетов больше нуля!";
		Сообщение.Поле = "КоличествоБилетов";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Кинозал) И Кинозал.Состояние = Перечисления.СостоянияЗалов.Закрыт Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Кинозал " + Строка(Кинозал) + " закрыт и недоступен для продажи билетов!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Движение = Движения.ВыручкаПоБилетам.Добавить();
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Кинозал = Кинозал;
	Движение.ТипБилета = ТипБилета;
	Движение.КоличествоБилетов = КоличествоБилетов;
	Движение.Сумма = Сумма;
	
	ДвижениеСтатус = Движения.ИсторияСтатусовЗалов.Добавить();
	ДвижениеСтатус.Период = НачалоСеанса;
	ДвижениеСтатус.Кинозал = Кинозал;
	ДвижениеСтатус.Статус = Перечисления.СтатусыЗалов.Занят;
	
	Если ЗначениеЗаполнено(ОкончаниеСеанса) И ОкончаниеСеанса > НачалоСеанса Тогда
		ДвижениеСтатус2 = Движения.ИсторияСтатусовЗалов.Добавить();
		ДвижениеСтатус2.Период = ОкончаниеСеанса;
		ДвижениеСтатус2.Кинозал = Кинозал;
		ДвижениеСтатус2.Статус = Перечисления.СтатусыЗалов.Свободен;
	КонецЕсли;
	
	ДвижениеБух = Движения.Проводки.Добавить();
	ДвижениеБух.Период = Дата;
	ДвижениеБух.СчетДт = ПланыСчетов.Управленческий.Взаиморасчеты;
	ДвижениеБух.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Клиенты] = Клиент;
	ДвижениеБух.СчетКт = ПланыСчетов.Управленческий.Выручка;
	ДвижениеБух.Сумма = Сумма;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ЗаявкаОбъект = ДокументОснование.ПолучитьОбъект();
		Если Не ЗаявкаОбъект.Обработана Тогда
			ЗаявкаОбъект.Обработана = Истина;
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			ЗапросЗадачи = Новый Запрос;
			ЗапросЗадачи.Текст = 
				"ВЫБРАТЬ
				|	ЗадачаИсполнителя.Ссылка КАК Ссылка
				|ИЗ
				|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
				|ГДЕ
				|	ЗадачаИсполнителя.ТочкаМаршрута = ЗНАЧЕНИЕ(БизнесПроцесс.ОбслуживаниеПосетителя.ТочкаМаршрута.ВстречаПосетителя)
				|	И ЗадачаИсполнителя.БизнесПроцесс.Клиент = &Клиент
				|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ";
			ЗапросЗадачи.УстановитьПараметр("Клиент", Клиент);
			РезультатЗадачи = ЗапросЗадачи.Выполнить();
			Если Не РезультатЗадачи.Пустой() Тогда
				ВыборкаЗадачи = РезультатЗадачи.Выбрать();
				Пока ВыборкаЗадачи.Следующий() Цикл
					ЗадачаОбъект = ВыборкаЗадачи.Ссылка.ПолучитьОбъект();
					ЗадачаОбъект.ВыполнитьЗадачу();
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	ДвижениеСтатус = Движения.ИсторияСтатусовЗалов.Добавить();
	ДвижениеСтатус.Период = ТекущаяДата();
	ДвижениеСтатус.Кинозал = Кинозал;
	ДвижениеСтатус.Статус = Перечисления.СтатусыЗалов.Свободен;
КонецПроцедуры
