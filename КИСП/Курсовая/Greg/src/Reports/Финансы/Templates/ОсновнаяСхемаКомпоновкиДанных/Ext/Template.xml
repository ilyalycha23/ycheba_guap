		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	"Итого по киноцентру" КАК Группировка,
	Проводки.Субконто1 КАК Клиент,
	СУММА(Проводки.СуммаОборотКт) КАК ФактическийОборот,
	СУММА(Проводки.СуммаОборотДт) КАК ТеоретическийОборот,
	0 КАК СебестоимостьЗалов
ИЗ
	РегистрБухгалтерии.Проводки.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , Счет = ЗНАЧЕНИЕ(ПланСчетов.Управленческий.Взаиморасчеты)) КАК Проводки
СГРУППИРОВАТЬ ПО
	Проводки.Субконто1

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	"Итого по киноцентру",
	ВыручкаПоБилетам.Клиент,
	0,
	0,
	СУММА(ВыручкаПоБилетам.КоличествоБилетовОборот * ВыручкаПоБилетам.Кинозал.СебестоимостьЗала)
ИЗ
	РегистрНакопления.ВыручкаПоБилетам.Обороты(&amp;НачалоПериода, &amp;КонецПериода) КАК ВыручкаПоБилетам
СГРУППИРОВАТЬ ПО
	ВыручкаПоБилетам.Клиент</query>
