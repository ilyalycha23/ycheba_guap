Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(ТипБилета) И ЗначениеЗаполнено(Кинозал) Тогда
		ИмяТипаБилета = ВРег(Строка(ТипБилета));
		КлассЗала = ВРег(Строка(Кинозал.КлассЗала));
		Если СтрНайти(ИмяТипаБилета, "VIP") > 0 ИЛИ СтрНайти(ИмяТипаБилета, "ВИП") > 0 Тогда
			Если СтрНайти(КлассЗала, "VIP") = 0 И СтрНайти(КлассЗала, "ВИП") = 0 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "VIP-билет можно продать только для VIP-зала!";
				Сообщение.Поле = "ТипБилета";
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Кинозал) И Кинозал.Состояние = Перечисления.СостоянияЗалов.Закрыт Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Кинозал " + Строка(Кинозал) + " закрыт и недоступен для бронирования!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если КоличествоБилетов <= 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите количество билетов больше нуля!";
		Сообщение.Поле = "КоличествоБилетов";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НачалоСеанса) И ЗначениеЗаполнено(ОкончаниеСеанса) И ОкончаниеСеанса < НачалоСеанса Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Окончание киносеанса не может быть раньше начала!";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Если Не Обработана Тогда
		БП = БизнесПроцессы.ОбслуживаниеПосетителя.СоздатьБизнесПроцесс();
		БП.Дата = Дата;
		БП.Клиент = Клиент;
		БП.Кинозал = Кинозал;
		БП.Записать();
		БП.Старт();
	КонецЕсли;
КонецПроцедуры
