Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Для Каждого СтрокаТЧ Из Товары Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(КоличествоОстаток), 0) КАК Остаток ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Период, Номенклатура = &Номенклатура)";
		Запрос.УстановитьПараметр("Период", Дата);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Остаток = 0;
		Если Выборка.Следующий() Тогда
			Остаток = Выборка.Остаток;
		КонецЕсли;
		
		Если СтрокаТЧ.Количество > Остаток Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Недостаточно товара """ + Строка(СтрокаТЧ.Номенклатура) + """ на складе! Остаток: " + Остаток;
			Сообщение.Поле = "Товары[" + (СтрокаТЧ.НомерСтроки - 1) + "].Количество";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Для Каждого СтрокаТЧ Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаТЧ.Номенклатура;
		Движение.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
КонецПроцедуры